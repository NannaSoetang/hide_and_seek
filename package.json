{
  "name": "hide_and_seek",
  "version": "1.0.0",
  "description": "Hide and seek mapping and preprocessing toolkit",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build:data": "uv run python -m scripts.build_data",
    "build:maps": ".venv/bin/python -m scripts.pdf.generate_transit_map_pdf --all-maps",
    "build:site": "vite build --config web/vite.config.js",
    "build": "npm run build:site",
    "preview": "vite preview --config web/vite.config.js",
    "test": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "vite": "^5.4.19"
  }
}
